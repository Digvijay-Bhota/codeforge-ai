# ── Application settings ───────────────────────────────────────────────────────
APP_NAME=CodeForge AI
APP_ENV=development
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
# Default matches the Docker Compose postgres service credentials.
# Never commit real credentials to source control.
DATABASE_URL=postgresql://codeforge:codeforge@postgres:5432/codeforge

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Phase 1: LLM / Agent ───────────────────────────────────────────────────────
# Your OpenAI API key. NEVER commit the real value — keep it in .env only.
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for the coding agent (default: gpt-4o).
CODEFORGE_MODEL=gpt-4o

# Optional: constrain workspace paths to a root directory.
# Leave empty to allow callers to pass absolute paths directly.
WORKSPACE_ROOT=

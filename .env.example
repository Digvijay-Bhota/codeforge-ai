# ── Application settings ───────────────────────────────────────────────────────
APP_NAME=CodeForge AI
APP_ENV=development
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
# Default matches the Docker Compose postgres service credentials.
# Never commit real credentials to source control.
DATABASE_URL=postgresql://codeforge:codeforge@postgres:5432/codeforge

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Phase 1: LLM / Agent ───────────────────────────────────────────────────────
# Your OpenAI API key. NEVER commit the real value — keep it in .env only.
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for the coding agent (default: gpt-4o).
CODEFORGE_MODEL=gpt-4o

# Maximum model turns for each coding-agent run (1–100, default 25).
# A turn is one model call plus the tool calls it requests.
CODEFORGE_CODING_MAX_TURNS=25

# How repository tests (untrusted code) are executed:
#   disabled    — default; nothing runs and tasks fail closed at testing.
#   host_unsafe — runs pytest on the worker host under the worker's UID.
#                 NOT a security boundary (tests can read worker secrets via
#                 /proc). Only accepted when APP_ENV is explicitly set to
#                 development or test (the default does not count);
#                 trusted repositories only.
#   sandbox     — approved isolated runtime. Not implemented yet, so this mode
#                 also fails closed. There is never a fallback to the host.
CODEFORGE_TEST_EXECUTION_MODE=disabled

# Repair attempts after a failed test run (0–5, default 0 = disabled).
# Each repair attempt runs the repository's tests again, so a nonzero value is
# rejected unless CODEFORGE_TEST_EXECUTION_MODE=sandbox.
CODEFORGE_MAX_REPAIR_ATTEMPTS=0

# execution_target=local runs the agent and the repository's tests directly on
# the worker host against a caller-supplied directory.  Disabled by default.
# When enabled, WORKSPACE_ROOT is required and every local workspace must
# resolve (following symlinks) to a directory strictly inside it.
# GitHub-targeted tasks are unaffected by this flag.
CODEFORGE_ALLOW_LOCAL_EXECUTION=false

# Absolute directory that contains local workspaces (required when local
# execution is enabled).  GitHub tasks also clone into it when set, otherwise
# into the system temp directory.
WORKSPACE_ROOT=

# ── Phase 10B.1: GitHub OAuth & Identity Authentication ─────────────────────────
# GitHub OAuth App credentials (required for developer login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Comma-separated or JSON list of authorized OAuth redirect targets
ALLOWED_OAUTH_REDIRECT_URIS=["http://localhost:8000/api/v1/auth/github/callback","http://localhost:3000/api/v1/auth/github/callback","http://127.0.0.1:8000/api/v1/auth/github/callback"]

# Session JWT secret (MUST be changed in production, at least 32 characters)
JWT_SECRET_KEY=insecure-codeforge-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400
OAUTH_STATE_TTL_SECONDS=600

# ── Application settings ───────────────────────────────────────────────────────
APP_NAME=CodeForge AI
APP_ENV=development
LOG_LEVEL=INFO

# ── Docker Compose (local development only) ────────────────────────────────────
# Required by docker-compose.yml: compose-guard refuses to start PostgreSQL and
# Redis until both are random values of at least 16 URL-safe characters
# (A-Z a-z 0-9 . _ ~ -).  Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Compose builds the services' DATABASE_URL and REDIS_URL from them.  Keep the
# values in .env only (it is gitignored); never commit them.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Database ───────────────────────────────────────────────────────────────────
# Only used when running the API outside Compose.  With
# docker-compose.dev-ports.yml the Compose database is on 127.0.0.1:5433.
DATABASE_URL=postgresql+asyncpg://codeforge:<postgres-password>@localhost:5433/codeforge

# ── Redis ──────────────────────────────────────────────────────────────────────
# Only used when running the API outside Compose.  Redis requires a password
# (it holds the job queue, OAuth state and the repository-permission cache).
REDIS_URL=redis://:<redis-password>@localhost:6379/0

# ── Phase 1: LLM / Agent ───────────────────────────────────────────────────────
# Your OpenAI API key. NEVER commit the real value — keep it in .env only.
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for the coding agent (default: gpt-4o).
CODEFORGE_MODEL=gpt-4o

# Maximum model turns for each coding-agent run (1–100, default 25).
# A turn is one model call plus the tool calls it requests.
CODEFORGE_CODING_MAX_TURNS=25

# How repository tests (untrusted code) are executed:
#   disabled    — default; nothing runs and tasks fail closed at testing.
#   host_unsafe — runs pytest on the worker host under the worker's UID, in a
#                 throwaway copy of the workspace snapshot (no .git, no
#                 secret-looking files; nothing is copied back).
#                 NOT a security boundary (tests can read worker secrets via
#                 /proc). Only accepted when APP_ENV is explicitly set to
#                 development or test (the default does not count);
#                 trusted repositories only.
#   docker      — runs pytest in a hardened throwaway container: snapshot
#                 streamed in (no host mounts), non-root, all capabilities
#                 dropped, no-new-privileges, read-only root, no network,
#                 CPU/memory/PIDs/time limits.  If Docker is unavailable or
#                 does not apply every control, tests fail closed.  A container
#                 on a shared kernel, not complete isolation; the worker needs
#                 Docker daemon access (root-equivalent on the daemon host).
#                 See docs/security/docker-test-executor.md.
#   gvisor      — the docker controls under a verified gVisor runtime (runsc),
#                 plus a guest task limit (RLIMIT_NPROC).  The runtime's
#                 registration, path, arguments and features are verified
#                 before anything is created, and the container's runtime
#                 after; anything wrong fails closed (never runc, never the
#                 host).  Needs a daemon with runsc registered as documented;
#                 the Compose worker cannot use it.  Does not permit repairs.
#                 See docs/security/gvisor-test-executor.md.
#   sandbox     — approved isolated runtime that permits repairs. Not
#                 implemented yet, so this mode also fails closed. There is
#                 never a fallback to the host.
CODEFORGE_TEST_EXECUTION_MODE=disabled

# Docker executor (CODEFORGE_TEST_EXECUTION_MODE=docker; also used by gvisor).
# The image must be pinned by digest: an image ID (sha256:<id>) from
# `docker build sandbox/docker`, or name@sha256:<digest>.  It is never pulled.
CODEFORGE_DOCKER_TEST_IMAGE=
CODEFORGE_DOCKER_CLI=docker
CODEFORGE_DOCKER_TIMEOUT_SECONDS=300
CODEFORGE_DOCKER_CPUS=1.0
CODEFORGE_DOCKER_MEMORY_MB=2048
CODEFORGE_DOCKER_PIDS_LIMIT=256

# gVisor executor (only used when CODEFORGE_TEST_EXECUTION_MODE=gvisor).
# Required, no defaults: the Docker runtime name registered for runsc (never
# runc/crun/youki) and the absolute runsc path, exactly as in daemon.json.
CODEFORGE_GVISOR_RUNTIME=
CODEFORGE_GVISOR_RUNTIME_PATH=
# Guest task limit (16-64; 64 is the measured value).  In gvisor mode
# CODEFORGE_DOCKER_PIDS_LIMIT must be at least 256 (and 4 x this) so that the
# host limit on runsc's own tasks is never reached before this one.
CODEFORGE_GVISOR_NPROC_LIMIT=64

# Repair attempts after a failed test run (0–5, default 0 = disabled).
# Each repair attempt runs the repository's tests again, so a nonzero value is
# rejected unless CODEFORGE_TEST_EXECUTION_MODE=sandbox (docker and gvisor
# are not enough).
CODEFORGE_MAX_REPAIR_ATTEMPTS=0

# execution_target=local runs the agent and the repository's tests directly on
# the worker host against a caller-supplied directory.  Disabled by default.
# When enabled, WORKSPACE_ROOT is required, only the accounts listed in
# CODEFORGE_LOCAL_EXECUTION_GITHUB_IDS may use it, and each account's local
# workspaces must resolve (following symlinks) to a directory strictly inside
# its own WORKSPACE_ROOT/<github user id>/ directory, which the operator creates.
# GitHub-targeted tasks are unaffected by this flag.
CODEFORGE_ALLOW_LOCAL_EXECUTION=false

# Absolute directory that contains the per-account local workspace directories
# (required when local execution is enabled).
WORKSPACE_ROOT=

# JSON list of immutable numeric GitHub user IDs (not logins) trusted to run
# code on the worker host, e.g. [12345678].  Find an ID with
# `gh api users/<login> --jq .id`.  Only these accounts may create, retry,
# approve or run local tasks, and under host_unsafe only their tasks' tests
# run.  Empty (the default) trusts nobody; logging in never adds anyone.
CODEFORGE_LOCAL_EXECUTION_GITHUB_IDS=[]

# Absolute directory GitHub tasks clone repositories into (default: the system
# temp directory).  It must not contain, or lie inside, WORKSPACE_ROOT; if
# WORKSPACE_ROOT is under the temp directory, set this explicitly.
CODEFORGE_GITHUB_CLONE_ROOT=

# ── Phase 10B.1: GitHub OAuth & Identity Authentication ─────────────────────────
# GitHub OAuth App credentials (required for developer login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Comma-separated or JSON list of authorized OAuth redirect targets
ALLOWED_OAUTH_REDIRECT_URIS=["http://localhost:8000/api/v1/auth/github/callback","http://localhost:3000/api/v1/auth/github/callback","http://127.0.0.1:8000/api/v1/auth/github/callback"]

# Session JWT secret.  This public placeholder is only accepted when APP_ENV is
# explicitly development or test; any other APP_ENV (production, staging, unset,
# ...) requires a random value of at least 32 characters, or startup fails.
JWT_SECRET_KEY=insecure-codeforge-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400
OAUTH_STATE_TTL_SECONDS=600

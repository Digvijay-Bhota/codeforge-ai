# ── Application settings ───────────────────────────────────────────────────────
APP_NAME=CodeForge AI
APP_ENV=development
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
# Default matches the Docker Compose postgres service credentials.
# Never commit real credentials to source control.
DATABASE_URL=postgresql://codeforge:codeforge@postgres:5432/codeforge

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Phase 1: LLM / Agent ───────────────────────────────────────────────────────
# Your OpenAI API key. NEVER commit the real value — keep it in .env only.
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for the coding agent (default: gpt-4o).
CODEFORGE_MODEL=gpt-4o

# Optional: constrain workspace paths to a root directory.
# Leave empty to allow callers to pass absolute paths directly.
WORKSPACE_ROOT=

# ── Phase 10B.1: GitHub OAuth & Identity Authentication ─────────────────────────
# GitHub OAuth App credentials (required for developer login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Comma-separated or JSON list of authorized OAuth redirect targets
ALLOWED_OAUTH_REDIRECT_URIS=["http://localhost:8000/api/v1/auth/github/callback","http://localhost:3000/api/v1/auth/github/callback","http://127.0.0.1:8000/api/v1/auth/github/callback"]

# Session JWT secret (MUST be changed in production, at least 32 characters)
JWT_SECRET_KEY=insecure-codeforge-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400
OAUTH_STATE_TTL_SECONDS=600
